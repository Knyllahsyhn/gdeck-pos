{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gdeck-pos",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    // One page only, so anything unknown lands on the register instead of a 404.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
